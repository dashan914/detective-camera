# The ESP32 only calls this local backend. Never put a provider key in firmware.
CAMERA_SHARED_TOKEN=replace-with-a-long-random-device-token
# Password for the browser management page. Keep this different from the device token.
DASHAN_ADMIN_TOKEN=replace-with-a-different-long-admin-password

# Any endpoint implementing the OpenAI Chat Completions interface works here:
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# A relay:  https://your-relay.example/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-provider-key
# Fill the exact model ID enabled by your provider account. Do not assume a model name.
AI_MODEL=

# Restrict photo upload size at the server edge.
MAX_IMAGE_BYTES=1800000

# Optional case narration: server-only secret; explicit free model, no paid fallback.
FISH_VOICE_ENABLED=0
FISH_API_KEY=
FISH_REFERENCE_ID=
